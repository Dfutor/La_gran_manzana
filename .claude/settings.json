{
  "permissions": {
    "allow": [
      "Bash(go build:*)",
      "Bash(go run:*)",
      "Bash(go test:*)",
      "Bash(go vet:*)",
      "Bash(gofmt:*)",
      "Bash(mysql -e:*)",
      "Bash(curl http://127.0.0.1:8080:*)",
      "Bash(curl -s http://127.0.0.1:8080:*)",
      "Bash(curl -i http://127.0.0.1:8080:*)",
      "Bash(git status:*)",
      "Bash(git diff:*)",
      "Bash(git log:*)"
    ],
    "deny": [
      "Read(./.env)",
      "Read(**/.env)",
      "Read(~/.my.cnf)",
      "Bash(cat .env:*)",
      "Bash(cat ./.env:*)"
    ]
  }
}
